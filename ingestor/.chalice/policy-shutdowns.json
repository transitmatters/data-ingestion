{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Effect": "Allow",
      "Resource": "arn:*:logs:*:*:*"
    },
    {
      "Effect": "Allow",
      "Action": ["dynamodb:BatchWriteItem"],
      "Resource": ["arn:aws:dynamodb:us-east-1:473352343756:table/Shutdowns"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::tm-mbta-performance/Alerts/lamp/*"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::tm-mbta-performance"],
      "Condition": { "StringLike": { "s3:prefix": ["Alerts/lamp/*"] } }
    }
  ]
}
